# Local development example only. Do not put real secrets in this file.
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-value-before-running
DATABASE_URL=sqlite:///data/demo.sqlite3
DEMO_MODE=1
MODEL_DIR=
SESSION_COOKIE_SECURE=0

# Internal research setup only: use a private PostgreSQL URL, DEMO_MODE=0,
# and a private MODEL_DIR. Never use Goodreads data in a public deployment.
